# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# Every name here must match a field on Settings in app/config.py.

# --- Secrets. Required at boot. ---
# Shared secret TradingView sends in the alert's JSON body, as the "token"
# key. Invent one, any long random string:
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`
WEBHOOK_TOKEN=replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Required from Phase 4. Leave blank until you have a bot token. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Operational. Defaults in config.py are fine; override only to tune. ---
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_INPUT_USD_PER_MTOK=1.00
# ANTHROPIC_OUTPUT_USD_PER_MTOK=5.00
# ANTHROPIC_MAX_TOKENS=1024
# LLM_MAX_ATTEMPTS=2
# DAILY_SPEND_CAP_USD=1.00
# DEDUPE_TTL_SECONDS=300
# BINANCE_BASE_URL=https://data-api.binance.vision
# HTTP_TIMEOUT_SECONDS=5.0
# DEMO_RATE_LIMIT_PER_HOUR=20
# LOG_LEVEL=INFO
