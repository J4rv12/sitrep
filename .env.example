# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# Every name here must match a field on Settings in app/config.py.

# --- Secrets. Required at boot. ---
# Shared secret TradingView sends in the alert's JSON body, as the "token"
# key. At least 32 characters, so the placeholder below fails at boot on
# purpose. Generate one:
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`
WEBHOOK_TOKEN=replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me
# From @BotFather's /newbot reply. Shaped like 8123456789:AAH...
TELEGRAM_BOT_TOKEN=replace-me
# Your chat with the bot. Press Start in that chat first, then read `chat.id`
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=replace-me

# --- Operational. Defaults in config.py are fine; override only to tune. ---
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_INPUT_USD_PER_MTOK=1.00
# ANTHROPIC_OUTPUT_USD_PER_MTOK=5.00
# ANTHROPIC_MAX_TOKENS=1024
# LLM_MAX_ATTEMPTS=2
# DAILY_SPEND_CAP_USD=1.00
# DEDUPE_TTL_SECONDS=300
# BINANCE_BASE_URL=https://data-api.binance.vision
# TELEGRAM_BASE_URL=https://api.telegram.org
# HTTP_TIMEOUT_SECONDS=5.0
# DEMO_RATE_LIMIT_PER_HOUR=20
# LOG_LEVEL=INFO
